{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Local file selection and the Free Transcribe CLI only",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "opener:allow-open-path",
    "shell:allow-kill",
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "ft", "cmd": "ft", "args": true, "sidecar": false }]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "ft", "cmd": "ft", "args": true, "sidecar": false }]
    }
  ]
}
